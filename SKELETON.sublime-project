{
    "folders": [
    {
        "path": ".",
        "name": "ant.skeleton.my",

        "file_exclude_patterns": [
            //
            ".osp",
            "*.sublime-*",
            "*.git*",
            "favicon.ico",
            ".htaccess",
            "composer.lock",
            ".env*",
            ".runway-config.json",
            "config_sample.php",

            "Vagrantfile",
            "database.sqlite",
            "docker-compose.yml",
            "phpstan.neon.dist",
            "phpunit.xml.dist",

            "runway",
            "LICENSE",


        ],

        "folder_exclude_patterns": [

            // "vendor",
            // "sessions",

            "public/lib/bootstrap/css",
            "public/lib/bootstrap/js",
            "public/lib/bootstrap-icons/font",
            "public/lib/bootstrap-icons/icons",
            // "smarty",
            "trash",
            "compile_dir",
            "smarty_cache",
            "tests",
            "migrations",
            "app/views"
        ]

    }],
    "settings":
    {


        "remember_open_files": true,
        "default_encoding": "UTF-8",
        "fallback_encoding": "UTF-8",

        "color_scheme": "Monokai Pro (Filter Machine).sublime-color-scheme",
        // "color_scheme": "Dark Knight.sublime-color-scheme",
        // "color_scheme": "Packages/Visual Studio Dark/Visual Studio Dark.tmTheme",
        "tab_size": 4,
        "translate_tabs_to_spaces": true,
        "trim_trailing_white_space_on_save": true,
        "ensure_newline_at_eof_on_save": true,
    },
}
