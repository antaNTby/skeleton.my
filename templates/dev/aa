<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$pageTitle|escape}</title>
    <link rel="stylesheet" href="/assets/css/schema-map.css">
    <script type="module">
        import mermaid from 'https://jsdelivr.net';
        mermaid.initialize({
            startOnLoad: true,
            theme: 'default',
            securityLevel: 'loose',
            er: { useMaxWidth: false }
        });
    </script>
</head>
<body>

<header>
    <div class="header-left">
        <h1>{$pageTitle|escape}</h1>
        <div class="legend">
            <span>━━ Жёсткий FK (relations_map)</span>
            <span>╌╌ Неявный *_id (relations_id)</span>
        </div>
    </div>
    <form method="post" action="/dev/schema-map/sync" class="sync-form">
        <button type="submit" class="btn-sync">↻ Пересинхронизировать схемы</button>
    </form>
</header>

{if $synced}
    <div class="alert-success">
        Схемы таблиц и карта связей успешно обновлены из базы данных (ручные настройки сохранены).
    </div>
{/if}

<div class="container">
    <div class="section-title">
        <span>ER-диаграмма базы данных ({$totalTables} табл.)</span>
    </div>
    <div class="diagram-wrapper">
        <pre class="mermaid">{$mermaidCode|escape}</pre>
    </div>

    <div class="section-title">
        <span>Структура таблиц и связи</span>
        <input type="text" id="tableFilter" class="search-input" placeholder="Фильтр по названию таблицы...">
    </div>

    <div class="cards-grid" id="tablesGrid">
        {foreach $tables as $table}
            <div class="card" data-table="{$table.name|escape}">
                <div class="card-header">
                    <span class="card-title">{$table.name|escape}</span>
                    <span class="badge badge-count">полей: {$table.fields|count}</span>
                </div>

                <table class="fields-table">
                    <tbody>
                    {foreach $table.fields as $field}
                        <tr>
                            <td class="col-name">
                                {$field|escape}
                                {if $field === $table.primaryKey}
                                    <span class="badge badge-pk" title="Primary Key">PK</span>
                                {/if}
                                {if isset($table.fkColumns[$field])}
                                    {if $table.fkColumns[$field] === 'foreign_key'}
                                        <span class="badge badge-fk" title="Строгий FOREIGN KEY">FK</span>
                                    {else}
                                        <span class="badge badge-id" title="Неявная связь *_id">ID</span>
                                    {/if}
                                {/if}
                            </td>
                            <td class="col-types">
                                <span class="php-type">{$table.fieldTypes[$field]|default:'mixed'|escape}</span>
                                <span class="sql-type">({$table.sqlTypes[$field]|default:''|escape})</span>
                            </td>
                        </tr>
                    {/foreach}
                    </tbody>
                </table>

                {if $table.relations}
                    <div class="relations-box">
                        <div class="relations-title">Связи ({$table.relations|count}):</div>
                        <div class="rel-list">
                            {foreach $table.relations as $relName => $rel}
                                {if $rel.type === 'hasMany'}
                                    <span class="rel-badge rel-hasmany" title="Обратная связь (1:N)">
                                        hasMany: {$relName|escape} → {$rel.table|escape}.{$rel.foreign_key|escape}
                                    </span>
                                {elseif ($rel.source|default:'') === 'implicit_id'}
                                    <span class="rel-badge rel-implicit" title="Неявная связь по *_id (display: {$rel.display_field|default:'id'|escape})">
                                        belongsTo: {$relName|escape} → {$rel.table|escape} ({$rel.foreign_key|escape})
                                    </span>
                                {else}
                                    <span class="rel-badge rel-belongs" title="Жёсткий FOREIGN KEY (display: {$rel.display_field|default:'id'|escape})">
                                        belongsTo: {$relName|escape} → {$rel.table|escape} ({$rel.foreign_key|escape})
                                    </span>
                                {/if}
                            {/foreach}
                        </div>
                    </div>
                {/if}
            </div>
        {/foreach}
    </div>
</div>

<script>
    document.getElementById('tableFilter')?.addEventListener('input', function (e) {
        const query = e.target.value.toLowerCase().trim();
        document.querySelectorAll('#tablesGrid .card').forEach(card => {
            const name = (card.dataset.table || '').toLowerCase();
            card.style.display = name.includes(query) ? '' : 'none';
        });
    });
</script>

</body>
</html>
